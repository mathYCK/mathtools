<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>平移為什麼是減</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.9/katex.min.css">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&display=swap">
<script defer src="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.9/katex.min.js"></script>
<style>
/* 版面：單欄卡片；每張示範卡＝方程式變化＋圖（左）＋三步驟（右），手機改上下排。
   顏色固定語意：灰＝舊圖形，藍＝新圖形，橘＝往回走的量，綠＝檢查通過。 */
:root {
  --ink: #1d2a3a; --muted: #5f6b7a; --paper: #f4f6f9; --card: #ffffff; --line: #dfe4ea;
  --old: #9aa4b1; --new: #2563c9; --newtint: #eaf1fc; --back: #d9730d; --backtint: #fdf1e5;
  --ok: #1e8a4c; --oktint: #e6f4ec;
  --f: "Noto Sans TC", "PingFang TC", "Microsoft JhengHei", sans-serif;
}
* { box-sizing: border-box; }
html, body { margin: 0; }
body { background: var(--paper); color: var(--ink); font-family: var(--f); font-size: 17px; line-height: 1.7; }
.wrap { max-width: 980px; margin: 0 auto; padding: 20px max(16px, env(safe-area-inset-right, 0px)) 48px max(16px, env(safe-area-inset-left, 0px)); display: flex; flex-direction: column; gap: 20px; }
.eyebrow { font-size: 13px; letter-spacing: .1em; color: var(--muted); margin: 0; }
h1 { font-size: clamp(26px, 5vw, 36px); font-weight: 900; line-height: 1.25; margin: 2px 0 4px; }
h2 { font-size: 20px; line-height: 1.4; margin: 0; }
p { margin: 0; }
.card { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 18px; display: flex; flex-direction: column; gap: 14px; min-width: 0; }
.head { display: flex; align-items: center; gap: 10px; }
.num { flex: none; width: 30px; height: 30px; border-radius: 50%; background: var(--ink); color: #fff; display: grid; place-items: center; font-weight: 700; font-size: 15px; }
.math { overflow-x: auto; overflow-y: hidden; }
.eq { font-size: 1.2em; background: var(--paper); border-radius: 8px; padding: 8px 12px; display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 12px; }
.concl .c2 { display: flex; flex-wrap: wrap; gap: 2px 12px; }
.eq .katex-display { margin: 4px 0; }

/* key card */
.big { font-size: clamp(20px, 3.6vw, 26px); font-weight: 700; line-height: 1.5; text-wrap: balance; }
.big em { font-style: normal; color: var(--back); }
.flow { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
.flow span { padding: 4px 12px; border-radius: 999px; font-weight: 500; font-size: 16px; }
.flow .a { background: var(--newtint); color: var(--new); }
.flow .b { background: var(--backtint); color: var(--back); }
.flow .c { background: var(--oktint); color: var(--ok); }
.flow i { font-style: normal; color: var(--muted); }
.rule { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 10px; }
.rule div { border: 2px solid var(--line); border-radius: 10px; padding: 10px 14px; display: flex; flex-direction: column; gap: 2px; }
.rule small { color: var(--muted); font-size: 14px; }
.rule b { font-size: 20px; }

/* demo */
.dgrid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 18px; align-items: start; }
@media (max-width: 760px) { .dgrid { grid-template-columns: minmax(0, 1fr); } }
.gwrap { display: flex; flex-direction: column; gap: 8px; align-items: center; min-width: 0; }
canvas { width: 100%; max-width: 480px; display: block; border-radius: 8px; border: 1px solid var(--line); background: #fff; touch-action: pan-y; cursor: pointer; }
.ctrl { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; justify-content: center; }
.ctrl span { font-size: 14px; color: var(--muted); }
button { font: inherit; color: inherit; cursor: pointer; }
.btn { border: 1px solid var(--line); background: #fff; border-radius: 8px; padding: 4px 14px; font-size: 15px; }
.btn.play { background: var(--new); border-color: var(--new); color: #fff; font-weight: 700; }
button:focus-visible, summary:focus-visible { outline: 3px solid var(--back); outline-offset: 2px; }
.key { display: flex; gap: 12px; font-size: 13px; color: var(--muted); flex-wrap: wrap; justify-content: center; }
.key span { display: inline-flex; align-items: center; gap: 5px; }
.key i { width: 18px; border-top: 3px solid; display: inline-block; }
ol.steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
ol.steps li { display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: 10px; align-items: start; border-radius: 10px; padding: 10px 12px; }
ol.steps li > b { width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; color: #fff; font-size: 14px; }
ol.steps li > div { min-width: 0; display: flex; flex-direction: column; gap: 2px; }
ol.steps .lbl { font-size: 14px; font-weight: 700; }
ol.steps .m { font-size: 1.12em; overflow-x: auto; overflow-y: hidden; }
.s1 { background: var(--newtint); } .s1 > b { background: var(--new); } .s1 .lbl { color: var(--new); }
.s2 { background: var(--backtint); } .s2 > b { background: var(--back); } .s2 .lbl { color: var(--back); }
.s3 { background: var(--oktint); } .s3 > b { background: var(--ok); } .s3 .lbl { color: var(--ok); }
.concl { border-left: 5px solid var(--back); padding: 6px 14px; background: var(--backtint); border-radius: 0 10px 10px 0; font-weight: 500; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; }
.concl .math { font-size: 1.12em; }
.tabs { display: flex; gap: 8px; flex-wrap: wrap; }
.tab { border: 2px solid var(--line); background: #fff; border-radius: 999px; padding: 2px 16px; font-weight: 500; }
.tab[aria-selected="true"] { border-color: var(--back); color: var(--back); background: var(--backtint); }

/* table */
.tbl { overflow-x: auto; }
table { border-collapse: collapse; font-size: 17px; min-width: 100%; font-variant-numeric: tabular-nums; }
th, td { border: 1px solid var(--line); padding: 8px 14px; text-align: center; white-space: nowrap; }
th { text-align: left; font-weight: 500; background: var(--paper); }
tr.o td { color: var(--muted); }
tr.n td { color: var(--new); font-weight: 700; }
tr.y td { color: var(--ink); }
.note { font-size: 16px; color: var(--back); font-weight: 700; }

.sub { color: var(--muted); }
.gen { display: flex; flex-direction: column; gap: 8px; }
.gen > div { border: 2px solid var(--line); border-radius: 10px; padding: 8px 14px; display: flex; flex-direction: column; min-width: 0; }
.gen small, .grid4 small { color: var(--muted); font-size: 14px; }
.gen .math { font-size: 1.15em; }
.grid4 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
.grid4 > div { background: var(--backtint); border-radius: 10px; padding: 8px 14px; display: flex; flex-direction: column; min-width: 0; }
.grid4 b { font-size: 18px; font-weight: 400; overflow-x: auto; }
@media (max-width: 420px) { .grid4 { grid-template-columns: minmax(0, 1fr); } }
.qtype { font-size: 17px; margin: 4px 0 0; }
.opts { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 6px; margin-top: 6px; }
.opt { text-align: left; border: 1.5px solid var(--line); background: #fff; border-radius: 8px; padding: 4px 10px; font-size: 16px; }
.opt.right { border-color: var(--ok); background: var(--oktint); }
.opt.wrong { border-color: #c23b2e; background: #fdeeee; }
.exp { margin-top: 6px; border-radius: 8px; padding: 8px 12px; font-size: 16px; }
.exp.ok { background: var(--oktint); } .exp.no { background: #fdeeee; }
/* quiz */
ol.quiz { margin: 0; padding-left: 1.4em; display: flex; flex-direction: column; gap: 14px; }
details { margin-top: 4px; }
summary { color: var(--new); font-size: 15px; cursor: pointer; width: fit-content; }
details > div { margin-top: 6px; background: var(--oktint); border-radius: 8px; padding: 8px 12px; }
.katex { white-space: nowrap; }
</style>
</head>
<body>
<div class="wrap">

<header>
  <p class="eyebrow">高中數學 ・ 圖形的平移 ・ 自學單</p>
  <h1>平移為什麼是減？</h1>
</header>

<!-- ① -->
<section class="card">
  <div class="head"><span class="num">1</span><h2>先記住一句話</h2></div>
  <p class="big">新圖形上的點，<em>把平移扣回去</em>，要落在舊圖形上。</p>
  <div class="flow">
    <span class="a">新圖形上的點</span><i>→</i><span class="b">把平移扣回去</span><i>→</i><span class="c">代入舊方程式 ✓</span>
  </div>
  <div class="rule">
    <div><small>圖形向右平移 2</small><b class="tx" data-t="x\ \text{換成}\ x\textcolor{#d9730d}{-2}"></b></div>
    <div><small>圖形向下平移 3</small><b class="tx" data-t="y\ \text{換成}\ y\textcolor{#d9730d}{+3}"></b></div>
  </div>
</section>

<!-- ② -->
<section class="card" id="dA"></section>


<!-- ④ ⑤ -->
<section class="card" id="dB"></section>
<section class="card" id="dC"></section>

<!-- ⑥ -->
<section class="card" id="dL"></section>

<!-- 推廣 -->
<section class="card">
  <div class="head"><span class="num">6</span><h2>推廣：用代數符號說</h2></div>
  <p class="sub">圖形向右平移 \(h\)、向上平移 \(k\)：</p>
  <ol class="steps">
    <li class="s1"><b>1</b><div><span class="lbl">新圖形上的點</span><span class="m tx" data-t="(x,\ y)"></span></div></li>
    <li class="s2"><b>2</b><div><span class="lbl">把平移扣回去：x 減 h，y 減 k</span><span class="m tx" data-t="(x\textcolor{#d9730d}{-h},\ y\textcolor{#d9730d}{-k})"></span></div></li>
    <li class="s3"><b>3</b><div><span class="lbl">這個點在舊圖形上，代入舊方程式就得到新方程式</span></div></li>
  </ol>
  <div class="gen">
    <div><small>拋物線</small><span class="math tx" data-t="y=x^2\ \longrightarrow\ y\textcolor{#d9730d}{-k}=(x\textcolor{#d9730d}{-h})^2"></span></div>
    <div><small>直線</small><span class="math tx" data-t="ax+by+c=0\ \longrightarrow\ a(x\textcolor{#d9730d}{-h})+b(y\textcolor{#d9730d}{-k})+c=0"></span></div>
  </div>
  <div class="grid4">
    <div><small>圖形向右 \(h\)</small><b class="tx" data-t="x\ \text{換成}\ x\textcolor{#d9730d}{-h}"></b></div>
    <div><small>圖形向左 \(h\)</small><b class="tx" data-t="x\ \text{換成}\ x\textcolor{#d9730d}{+h}"></b></div>
    <div><small>圖形向上 \(k\)</small><b class="tx" data-t="y\ \text{換成}\ y\textcolor{#d9730d}{-k}"></b></div>
    <div><small>圖形向下 \(k\)</small><b class="tx" data-t="y\ \text{換成}\ y\textcolor{#d9730d}{+k}"></b></div>
  </div>
</section>

<!-- 自我檢查 -->
<section class="card">
  <div class="head"><span class="num">7</span><h2>自我檢查</h2></div>
  <h3 class="qtype">一、單選題</h3>
  <ol class="quiz" id="mc"></ol>
  <h3 class="qtype">二、填充題</h3>
  <ol class="quiz fill">
    <li>將直線 \(4x-y+3=0\) 向右平移 2 單位，所得直線方程式為＿＿＿＿＿。
      <details><summary>看答案</summary><div>\(4x-y-5=0\)<br>x 換成 \(x-2\)：\(4(x-2)-y+3=0\)</div></details></li>
    <li>將拋物線 \(y=x^2\) 向左平移 3 單位，再向下平移 2 單位，所得方程式為＿＿＿＿＿。
      <details><summary>看答案</summary><div>\(y=(x+3)^2-2\)<br>x 換成 \(x+3\)，y 換成 \(y+2\)：\(y+2=(x+3)^2\)</div></details></li>
    <li>將直線 \(x+y-6=0\) 向下平移 \(k\) 單位後通過原點，則 \(k=\)＿＿＿＿＿。
      <details><summary>看答案</summary><div>\(k=6\)<br>y 換成 \(y+k\)：\(x+y+k-6=0\)，代入 \((0,0)\) 得 \(k-6=0\)</div></details></li>
    <li>拋物線 \(y=x^2\) 向＿＿平移＿＿單位、再向＿＿平移＿＿單位，可得 \(y=(x-5)^2-7\)。
      <details><summary>看答案</summary><div>向右 5、向下 7<br>改寫成 \(y+7=(x-5)^2\)：x 換成 \(x-5\)（向右 5），y 換成 \(y+7\)（向下 7）</div></details></li>
  </ol>
</section>

</div>

<script>
(function () {
  var C = { old: "#9aa4b1", nw: "#2563c9", back: "#d9730d", ok: "#1e8a4c", ink: "#1d2a3a", grid: "#edf0f4", axis: "#7b8794" };
  var OR = "\\textcolor{#d9730d}";
  function tex(el, t, display) {
    if (window.katex) katex.render(t, el, { throwOnError: false, displayMode: !!display });
    else el.textContent = t.replace(/\\color\{[^}]*\}/g, "").replace(/\\[a-zA-Z]+/g, " ").replace(/[{}]/g, "");
  }
  function n(v) { return v < 0 ? "(" + v + ")" : String(v); }

  var parab = {
    f: function (x) { return x * x; },
    oldTex: "y=x^2",
    check: function (x, y) { return y + "=" + n(x) + "^2"; },
    xr: [-4, 8], yr: [-5, 18], ystep: 2
  };
  var line = {
    f: function (x) { return 2 * x; },
    oldTex: "2x-y=0",
    check: function (x, y) { return "2\\cdot" + n(x) + "-" + n(y) + "=0"; },
    xr: [-3, 8], yr: [-9, 14], ystep: 2
  };

  // h = 向右量, k = 向上量（向下 3 → k = -3）
  var demos = {
    dA: { num: 2, title: "例子 1：拋物線向右平移 2", base: parab, h: 2, k: 0, px: 5,
          eq: "y=x^2\\ \\longrightarrow\\ y=(x" + OR + "{-2})^2",
          concl: ["檢查新點時，x 要先減 2", "y=(x" + OR + "{-2})^2"] },
    dB: { num: 3, title: "例子 2：拋物線向下平移 3", base: parab, h: 0, k: -3, px: 3,
          eq: "y=x^2\\ \\longrightarrow\\ y" + OR + "{+3}=x^2",
          concl: ["檢查新點時，y 要先加 3", "y" + OR + "{+3}=x^2"] },
    dC: { num: 4, title: "例子 3：拋物線向右 2、向下 3", base: parab, h: 2, k: -3, px: 5,
          eq: "y=x^2\\ \\longrightarrow\\ y" + OR + "{+3}=(x" + OR + "{-2})^2",
          concl: ["x 減 2、y 加 3，兩個一起換", "y" + OR + "{+3}=(x" + OR + "{-2})^2"] }
  };
  var lineModes = [
    { tab: "向右平移 2", base: line, h: 2, k: 0, px: 5,
      eq: "2x-y=0\\ \\longrightarrow\\ 2(x" + OR + "{-2})-y=0",
      concl: ["x 換成 x−2", "2(x" + OR + "{-2})-y=0\\ \\Rightarrow\\ 2x-y-4=0"] },
    { tab: "向下平移 3", base: line, h: 0, k: -3, px: 4,
      eq: "2x-y=0\\ \\longrightarrow\\ 2x-(y" + OR + "{+3})=0",
      concl: ["y 換成 y+3", "2x-(y" + OR + "{+3})=0\\ \\Rightarrow\\ 2x-y-3=0"] },
    { tab: "向右 2、向下 3", base: line, h: 2, k: -3, px: 5,
      eq: "2x-y=0\\ \\longrightarrow\\ 2(x" + OR + "{-2})-(y" + OR + "{+3})=0",
      concl: ["兩個一起換", "2(x" + OR + "{-2})-(y" + OR + "{+3})=0\\ \\Rightarrow\\ 2x-y-7=0"] }
  ];

  function dirText(h, k) {
    var a = [];
    if (h) a.push("x " + (h > 0 ? "減 " : "加 ") + Math.abs(h));
    if (k) a.push("y " + (k < 0 ? "加 " : "減 ") + Math.abs(k));
    return a.join("、");
  }

  function build(sec, cfg, modes) {
    var st = { cfg: cfg, px: cfg.px, anim: null };
    sec.innerHTML =
      '<div class="head"><span class="num">' + cfg.num + '</span><h2>' + cfg.title + '</h2></div>' +
      (modes ? '<div class="tabs" role="tablist"></div>' : '') +
      '<div class="math eq"></div>' +
      '<div class="dgrid"><div class="gwrap"><canvas></canvas>' +
      '<div class="key"><span><i style="border-color:' + C.old + '"></i>舊圖形</span><span><i style="border-color:' + C.nw + '"></i>新圖形</span><span><i style="border-color:' + C.back + '"></i>扣回平移</span></div>' +
      '<div class="ctrl"><button class="btn prev" type="button" aria-label="點往左移">◀</button><span>拖曳藍點，或按箭頭</span><button class="btn next" type="button" aria-label="點往右移">▶</button><button class="btn play" type="button">看平移</button></div></div>' +
      '<ol class="steps">' +
      '<li class="s1"><b>1</b><div><span class="lbl">新圖形上的點</span><span class="m m1"></span></div></li>' +
      '<li class="s2"><b>2</b><div><span class="lbl l2"></span><span class="m m2"></span></div></li>' +
      '<li class="s3"><b>3</b><div><span class="lbl">代入舊方程式 <span class="m0"></span></span><span class="m m3"></span></div></li>' +
      '</ol></div>' +
      '<p class="concl"><span class="c1"></span><span class="math c2"></span></p>';
    var cv = sec.querySelector("canvas"), ctx = cv.getContext("2d");
    var q = function (s) { return sec.querySelector(s); };

    if (modes) {
      var tabs = q(".tabs");
      modes.forEach(function (m, i) {
        var b = document.createElement("button");
        b.type = "button"; b.className = "tab"; b.textContent = m.tab; b.setAttribute("role", "tab");
        b.setAttribute("aria-selected", i === 0 ? "true" : "false");
        b.addEventListener("click", function () {
          [].forEach.call(tabs.children, function (t) { t.setAttribute("aria-selected", "false"); });
          b.setAttribute("aria-selected", "true");
          st.cfg = Object.assign({}, cfg, m); st.px = m.px; st.anim = null; render();
        });
        tabs.appendChild(b);
      });
      st.cfg = Object.assign({}, cfg, modes[0]);
      st.px = modes[0].px;
    }

    function allowed() {
      var c = st.cfg, b = c.base, out = [];
      for (var x = b.xr[0] + 1; x <= b.xr[1] - 1; x++) {
        var y = b.f(x - c.h) + c.k, y0 = y - c.k;
        if (y > b.yr[0] + 0.5 && y < b.yr[1] - 0.5 && y0 > b.yr[0] + 0.5 && y0 < b.yr[1] - 0.5 && x - c.h > b.xr[0]) out.push(x);
      }
      return out;
    }

    var W = 0, H = 0;
    function size() {
      var dpr = window.devicePixelRatio || 1;
      W = cv.clientWidth; H = Math.round(W * 0.92);
      cv.style.height = H + "px";
      cv.width = Math.round(W * dpr); cv.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      draw();
    }
    function X(x) { var r = st.cfg.base.xr; return (x - r[0]) / (r[1] - r[0]) * W; }
    function Y(y) { var r = st.cfg.base.yr; return (r[1] - y) / (r[1] - r[0]) * H; }
    function curve(dx, dy, color, w, dash) {
      var b = st.cfg.base;
      ctx.save(); ctx.strokeStyle = color; ctx.lineWidth = w; ctx.setLineDash(dash || []); ctx.beginPath();
      for (var i = 0; i <= 240; i++) {
        var x = b.xr[0] + (b.xr[1] - b.xr[0]) * i / 240, y = b.f(x - dx) + dy;
        i ? ctx.lineTo(X(x), Y(y)) : ctx.moveTo(X(x), Y(y));
      }
      ctx.stroke(); ctx.restore();
    }
    function arrowHead(x1, y1, x2, y2) {
      var a = Math.atan2(y2 - y1, x2 - x1), L = 11;
      ctx.beginPath(); ctx.moveTo(x2, y2);
      ctx.lineTo(x2 - L * Math.cos(a - .45), y2 - L * Math.sin(a - .45));
      ctx.lineTo(x2 - L * Math.cos(a + .45), y2 - L * Math.sin(a + .45)); ctx.closePath(); ctx.fill();
    }
    function tag(text, x, y, color, align) {
      ctx.font = "700 15px " + getComputedStyle(document.body).fontFamily;
      var w = ctx.measureText(text).width + 10, bx = align === "r" ? x - w : (align === "c" ? x - w / 2 : x);
      bx = Math.max(2, Math.min(W - w - 2, bx)); y = Math.max(12, Math.min(H - 12, y));
      ctx.fillStyle = "rgba(255,255,255,.92)"; ctx.fillRect(bx, y - 11, w, 22);
      ctx.fillStyle = color; ctx.textBaseline = "middle"; ctx.textAlign = "left"; ctx.fillText(text, bx + 5, y);
    }
    function draw() {
      if (!W) return;
      var c = st.cfg, b = c.base;
      ctx.clearRect(0, 0, W, H); ctx.fillStyle = "#fff"; ctx.fillRect(0, 0, W, H);
      ctx.lineWidth = 1;
      for (var gx = Math.ceil(b.xr[0]); gx <= b.xr[1]; gx++) { ctx.strokeStyle = gx === 0 ? C.axis : C.grid; ctx.beginPath(); ctx.moveTo(X(gx), 0); ctx.lineTo(X(gx), H); ctx.stroke(); }
      for (var gy = Math.ceil(b.yr[0]); gy <= b.yr[1]; gy++) { ctx.strokeStyle = gy === 0 ? C.axis : C.grid; ctx.beginPath(); ctx.moveTo(0, Y(gy)); ctx.lineTo(W, Y(gy)); ctx.stroke(); }
      ctx.fillStyle = C.axis; ctx.font = "12px " + getComputedStyle(document.body).fontFamily;
      ctx.textAlign = "center"; ctx.textBaseline = "top";
      for (gx = Math.ceil(b.xr[0]) + 1; gx < b.xr[1]; gx++) if (gx) ctx.fillText(gx, X(gx), Y(0) + 3);
      ctx.textAlign = "right"; ctx.textBaseline = "middle";
      for (gy = Math.ceil(b.yr[0] / b.ystep) * b.ystep; gy < b.yr[1]; gy += b.ystep) if (gy) ctx.fillText(gy, X(0) - 4, Y(gy));

      curve(0, 0, C.old, 3);
      if (st.anim) { curve(c.h * st.anim, c.k * st.anim, C.nw, 3, [8, 6]); return; }
      curve(c.h, c.k, C.nw, 3);

      var px = st.px, py = b.f(px - c.h) + c.k, ox = px - c.h, oy = py - c.k;
      // path back: horizontal then vertical
      ctx.save(); ctx.strokeStyle = C.back; ctx.fillStyle = C.back; ctx.lineWidth = 3; ctx.setLineDash([7, 5]);
      var mx = ox, my = py;
      if (c.h) {
        ctx.beginPath(); ctx.moveTo(X(px), Y(py)); ctx.lineTo(X(mx), Y(my)); ctx.stroke();
        if (!c.k) { ctx.setLineDash([]); arrowHead(X(px), Y(py), X(mx), Y(my)); }
      }
      if (c.k) {
        ctx.setLineDash([7, 5]); ctx.beginPath(); ctx.moveTo(X(mx), Y(my)); ctx.lineTo(X(ox), Y(oy)); ctx.stroke();
        ctx.setLineDash([]); arrowHead(X(mx), Y(my), X(ox), Y(oy));
      }
      ctx.restore();
      if (c.h) tag((c.h > 0 ? "減 " : "加 ") + Math.abs(c.h), (X(px) + X(mx)) / 2, Y(py) + 18, C.back, "c");
      if (c.k) tag((c.k < 0 ? "加 " : "減 ") + Math.abs(c.k), X(mx) + 8, (Y(my) + Y(oy)) / 2, C.back, "l");
      // points
      ctx.fillStyle = "#fff"; ctx.strokeStyle = C.old; ctx.lineWidth = 3;
      ctx.beginPath(); ctx.arc(X(ox), Y(oy), 6, 0, 7); ctx.fill(); ctx.stroke();
      ctx.fillStyle = C.nw; ctx.beginPath(); ctx.arc(X(px), Y(py), 9, 0, 7); ctx.fill();
      ctx.fillStyle = "#fff"; ctx.beginPath(); ctx.arc(X(px), Y(py), 3, 0, 7); ctx.fill();
      var oxLeft = X(ox) < X(px) || (c.h === 0 && X(ox) < W / 2);
      tag("(" + px + ", " + py + ")", X(px) + (oxLeft ? 14 : -14), Y(py) - (c.h ? 0 : 0), C.nw, oxLeft ? "l" : "r");
      tag("(" + ox + ", " + oy + ")", X(ox) + (oxLeft ? -12 : 12), Y(oy) - (c.h && !c.k ? 0 : 0), "#5f6b7a", oxLeft ? "r" : "l");
    }

    function render() {
      var c = st.cfg, b = c.base, px = st.px, py = b.f(px - c.h) + c.k, ox = px - c.h, oy = py - c.k;
      var eqEl = q(".eq"); eqEl.innerHTML = "";
      c.eq.split("\\ \\longrightarrow\\ ").forEach(function (part, i) {
        var sp = document.createElement("span"); eqEl.appendChild(sp); tex(sp, (i ? "\\longrightarrow\\ " : "") + part);
      });
      tex(q(".m1"), "(" + px + ",\\ " + py + ")");
      q(".l2").textContent = "把平移扣回去：" + dirText(c.h, c.k);
      var xs = c.h ? px + OR + "{" + (c.h > 0 ? "-" : "+") + Math.abs(c.h) + "}" : String(px);
      var ys = c.k ? py + OR + "{" + (c.k < 0 ? "+" : "-") + Math.abs(c.k) + "}" : String(py);
      tex(q(".m2"), "(" + xs + ",\\ " + ys + ")=(" + ox + ",\\ " + oy + ")");
      tex(q(".m0"), b.oldTex);
      tex(q(".m3"), b.check(ox, oy) + "\\ \\checkmark");
      q(".c1").textContent = c.concl[0] + "：";
      var c2 = q(".c2"); c2.innerHTML = "";
      c.concl[1].split("\\ \\Rightarrow\\ ").forEach(function (part, i) {
        var sp = document.createElement("span"); c2.appendChild(sp); tex(sp, (i ? "\\Rightarrow\\ " : "") + part);
      });
      draw();
    }
    function move(d) {
      var a = allowed(), i = a.indexOf(st.px);
      if (i < 0) i = 0;
      st.px = a[Math.max(0, Math.min(a.length - 1, i + d))]; st.anim = null; render();
    }
    q(".prev").addEventListener("click", function () { move(-1); });
    q(".next").addEventListener("click", function () { move(1); });
    q(".play").addEventListener("click", function () {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      var t0 = performance.now();
      (function step(t) {
        var p = Math.min(1, (t - t0) / 1500);
        st.anim = p < 1 ? Math.max(0.001, p < .5 ? 2 * p * p : 1 - Math.pow(-2 * p + 2, 2) / 2) : null;
        draw(); if (p < 1) requestAnimationFrame(step);
      })(t0);
    });
    var dragging = false;
    function pick(e) {
      var r = cv.getBoundingClientRect(), b = st.cfg.base;
      var x = b.xr[0] + (e.clientX - r.left) / r.width * (b.xr[1] - b.xr[0]);
      var a = allowed(), best = a[0];
      a.forEach(function (v) { if (Math.abs(v - x) < Math.abs(best - x)) best = v; });
      if (best !== st.px) { st.px = best; st.anim = null; render(); }
    }
    cv.addEventListener("pointerdown", function (e) { dragging = true; cv.setPointerCapture(e.pointerId); pick(e); });
    cv.addEventListener("pointermove", function (e) { if (dragging) pick(e); });
    cv.addEventListener("pointerup", function () { dragging = false; });
    cv.addEventListener("pointercancel", function () { dragging = false; });
    window.addEventListener("resize", size);
    render(); size();
  }

  var MC = [
    { q: "將拋物線 \\(y=x^2\\) 向右平移 3 單位，所得圖形的方程式為",
      o: ["y=x^2+3", "y=x^2-3", "y=(x+3)^2", "y=(x-3)^2", "y=3x^2"], a: 3,
      e: "向右 3：x 換成 \\(x-3\\)，得 \\(y=(x-3)^2\\)" },
    { q: "將拋物線 \\(y=x^2\\) 向下平移 4 單位，所得圖形的方程式為",
      o: ["y-4=x^2", "y+4=x^2", "y=(x-4)^2", "y=(x+4)^2", "y=x^2+4"], a: 1,
      e: "向下 4：y 換成 \\(y+4\\)，得 \\(y+4=x^2\\)，即 \\(y=x^2-4\\)" },
    { q: "將直線 \\(3x+y-2=0\\) 向左平移 2 單位，所得直線方程式為",
      o: ["3x+y-8=0", "3x+y+4=0", "3x+y=0", "3x+y-4=0", "3x+y+2=0"], a: 1,
      e: "向左 2：x 換成 \\(x+2\\)，\\(3(x+2)+y-2=0\\)，即 \\(3x+y+4=0\\)" },
    { q: "將直線 \\(x-2y+4=0\\) 向上平移 3 單位，所得直線方程式為",
      o: ["x-2y+10=0", "x-2y-2=0", "x-2y+7=0", "x-2y+1=0", "x-2y-6=0"], a: 0,
      e: "向上 3：y 換成 \\(y-3\\)，\\(x-2(y-3)+4=0\\)，即 \\(x-2y+10=0\\)" },
    { q: "將拋物線 \\(y=x^2\\) 向右平移 2 單位，再向上平移 5 單位，所得方程式為",
      o: ["y=(x-2)^2+5", "y=(x+2)^2+5", "y=(x-2)^2-5", "y=(x+2)^2-5", "y+5=(x-2)^2"], a: 0,
      e: "x 換成 \\(x-2\\)，y 換成 \\(y-5\\)：\\(y-5=(x-2)^2\\)，即 \\(y=(x-2)^2+5\\)" },
    { q: "方程式 \\(y+1=(x+4)^2\\) 的圖形，可由 \\(y=x^2\\) 的圖形如何平移得到？",
      o: ["\\text{向右 4、向上 1}", "\\text{向右 4、向下 1}", "\\text{向左 4、向上 1}", "\\text{向左 4、向下 1}", "\\text{向左 1、向下 4}"], a: 3,
      e: "\\(x+4\\)：x 加 4，圖形向左 4；\\(y+1\\)：y 加 1，圖形向下 1" },
    { q: "直線 \\(L\\) 向右平移 2 單位後，得到直線 \\(2x+3y-5=0\\)。則 \\(L\\) 的方程式為",
      o: ["2x+3y-1=0", "2x+3y-9=0", "2x+3y-3=0", "2x+3y-7=0", "2x+3y+1=0"], a: 0,
      e: "把新直線向左平移 2 就回到 \\(L\\)：x 換成 \\(x+2\\)，\\(2(x+2)+3y-5=0\\)，即 \\(2x+3y-1=0\\)" }
  ];
  function inl(t) { return window.katex ? t.replace(/\\\(([\s\S]+?)\\\)/g, function (_, m) { return katex.renderToString(m, { throwOnError: false }); }) : t.replace(/\\\(|\\\)/g, ""); }
  function buildMC() {
    var ol = document.getElementById("mc"), L = "ABCDE";
    MC.forEach(function (it) {
      var li = document.createElement("li");
      li.innerHTML = "<span>" + inl(it.q) + "</span><div class='opts'></div><div class='exp' hidden></div>";
      var box = li.querySelector(".opts"), exp = li.querySelector(".exp");
      it.o.forEach(function (o, j) {
        var b = document.createElement("button");
        b.type = "button"; b.className = "opt";
        b.innerHTML = "(" + L[j] + ") <span></span>";
        var m = o.match(/^\\text\{(.*)\}$/);
        if (m) b.querySelector("span").textContent = m[1]; else tex(b.querySelector("span"), o);
        b.addEventListener("click", function () {
          [].forEach.call(box.children, function (x) { x.classList.remove("right", "wrong"); });
          var ok = j === it.a;
          b.classList.add(ok ? "right" : "wrong");
          exp.hidden = false; exp.className = "exp " + (ok ? "ok" : "no");
          exp.innerHTML = (ok ? "<b>答對了。</b>" : "<b>再想想。</b>") + inl(it.e);
          if (!ok) exp.innerHTML = "<b>再想想：</b>先判斷 x、y 各要換成什麼，再代入。";
        });
        box.appendChild(b);
      });
      ol.appendChild(li);
    });
  }

  function init() {
    [].forEach.call(document.querySelectorAll(".tx"), function (el) { tex(el, el.dataset.t); });
    [].forEach.call(document.querySelectorAll(".tx-i"), function (el) { tex(el, el.dataset.t); });
    buildMC();
    if (window.katex) [].forEach.call(document.querySelectorAll(".sub, .fill li, .grid4 small"), function (el) {
      el.innerHTML = el.innerHTML.replace(/\\\(([\s\S]+?)\\\)/g, function (_, t) { return katex.renderToString(t, { throwOnError: false }); });
    });
    build(document.getElementById("dA"), demos.dA);
    build(document.getElementById("dB"), demos.dB);
    build(document.getElementById("dC"), demos.dC);
    build(document.getElementById("dL"), { num: 5, title: "例子 4：直線 2x − y = 0", base: line }, lineModes);
  }
  if (document.readyState === "complete") init(); else window.addEventListener("load", init);
})();
</script>
